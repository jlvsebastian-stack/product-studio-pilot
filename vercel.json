{
  "functions": {
    "api/mcp.js": {
      "maxDuration": 60,
      "includeFiles": "{public/**,skills/**,fonts/**}"
    }
  },
  "rewrites": [{ "source": "/mcp/:invite", "destination": "/api/mcp?invite=:invite" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" }
  ] }]
}
